{
  "type": "object",
  "description": "Growth/archiving-adjusted, per-instance SAP sizing recommendation, produced by skills/sizing-analysis from a technical or RISE FUE-tier baseline.",
  "required": ["methodology", "assumptions", "per_instance", "combined_total_memory_gib", "combined_total_disk_gib"],
  "properties": {
    "methodology": {
      "type": "object",
      "required": ["source", "basis"],
      "properties": {
        "source": { "type": "string", "description": "e.g. 'Readiness Check Chapter 6', 'Quick Sizer export', 'RISE FUE count'" },
        "basis": { "type": "string", "enum": ["measured", "estimated", "license-tier-derived"] }
      }
    },
    "assumptions": {
      "type": "object",
      "required": ["growth_pct_per_year", "years_of_growth_to_provision"],
      "properties": {
        "growth_pct_per_year": { "type": "number" },
        "years_of_growth_to_provision": { "type": "number" },
        "archiving_reduction_gib": { "type": "number" },
        "new_functionality_gib": { "type": "number" },
        "zero_growth_acknowledged": {
          "type": "boolean",
          "description": "Must be explicitly true if growth is genuinely 0 — a silent default is not acceptable."
        }
      }
    },
    "per_instance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "baseline_memory_gib", "recommended_memory_gib", "recommended_disk_gib"],
        "properties": {
          "name": { "type": "string" },
          "baseline_memory_gib": { "type": "number" },
          "baseline_disk_gib": { "type": "number" },
          "growth_factor_applied": { "type": "number" },
          "recommended_memory_gib": { "type": "number" },
          "recommended_disk_gib": { "type": "number" }
        }
      }
    },
    "combined_total_memory_gib": { "type": "number" },
    "combined_total_disk_gib": { "type": "number" },
    "rise_tier_mismatch": {
      "type": "object",
      "description": "Present only when a RISE FUE tier and the technical data volume disagree.",
      "properties": {
        "fue_tier": { "type": "string" },
        "technical_volume_gib": { "type": "number" },
        "flag": { "type": "string" }
      }
    }
  }
}
