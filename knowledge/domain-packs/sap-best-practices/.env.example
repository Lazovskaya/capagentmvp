# Credentials for Methods 1-2 (SAP Cloud ALM Process Content API, SAP Signavio Process Manager)
# enrichment of this domain pack -- see README.md "Planned enrichment (methods 1-2)".
#
# Copy this file OUTSIDE the repo before filling in real values -- never commit a filled-in .env.
# Following this factory's existing connector pattern (see connectors/jira/connector.md and
# connectors/abap-mcp/connector.md), the real file belongs at:
#   ~/.config/sap-best-practices/sessions/<destination>.env
# and gets loaded by a launcher script, never referenced directly from .mcp.json or committed
# config -- <destination> is any name you choose for this tenant (e.g. "default", "client-x-dev").

# OAuth 2.0 token endpoint from the Cloud ALM service key (BTP subaccount -> Instances and
# Subscriptions -> your Cloud ALM service instance -> Service Keys -> "uaa.url" + "/oauth/token").
CLOUD_ALM_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token

# Client ID / secret from that same service key ("clientid" / "clientsecret").
CLOUD_ALM_CLIENT_ID=sb-your-client-id!t12345
CLOUD_ALM_CLIENT_SECRET=your-client-secret

# Cloud ALM API base URL for your tenant (service key "url", or the tenant's API host from
# SAP Cloud ALM -> Administration -> API Access).
CLOUD_ALM_API_URL=https://your-tenant.alm.cloud.sap

# Optional: restrict which process area/scope items an enrichment run pulls, so a first real run
# stays small and reviewable. Leave blank to fetch everything the client is entitled to.
CLOUD_ALM_SCOPE_ITEM_FILTER=BD9,J45,J58

# Credentials for Method 2, read by tools/enrich_sap_best_practices_signavio.py. Confirmed
# working against a real tenant on 2026-08-24 -- this is not a Cloud-ALM-style OAuth service
# key, it's a plain username/password + tenant ID login against Signavio's own /p/login
# endpoint. Get these from a Signavio technical/integration user, not a personal account.

# Signavio host -- the shared SAP SaaS editor unless your org has a dedicated domain.
SIGNAVIO_HOST=https://editor.signavio.com

# Workspace/Tenant ID -- Signavio Explorer -> Administration -> API tab, listed as "Tenant ID".
SIGNAVIO_TENANT_ID=your-workspace-tenant-id

# A technical user's email + password (not a personal account's -- this factory used a
# dedicated "auto_..." integration account). No token/OAuth alternative exists for this API.
SIGNAVIO_USER=your-technical-user@example.com
SIGNAVIO_PASSWORD=your-password
