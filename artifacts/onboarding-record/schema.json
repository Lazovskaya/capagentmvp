{
  "type": "object",
  "description": "Ready to take a ticket, evidenced. Produced by onboarding-guide, one per joiner. Person readiness and knowledge-base defects are independent outcomes.",
  "required": [
    "joiner",
    "role",
    "facilitator",
    "session_dates",
    "per_bucket_walkthrough",
    "end_to_end_test",
    "person_readiness",
    "confirmed_by",
    "confirmation_date"
  ],
  "properties": {
    "joiner": { "type": "string" },
    "role": {
      "type": "string",
      "enum": ["functional", "developer", "architect", "delivery", "basis", "data", "test"]
    },
    "facilitator": { "type": "string" },
    "session_dates": { "type": "string" },
    "per_bucket_walkthrough": {
      "type": "array",
      "description": "One row per bucket — all nine (eight client-specific plus clean-core), even light-depth ones.",
      "items": {
        "type": "object",
        "required": ["bucket", "depth", "bucket_status"],
        "properties": {
          "bucket": { "type": "string" },
          "depth": { "type": "string", "enum": ["deep", "light"] },
          "bucket_status": { "type": "string", "enum": ["Validated", "In review", "Inferred", "Reopened"] },
          "open_findings_flag": { "type": "boolean" },
          "caveats": { "type": "string" },
          "understanding_check_result": { "type": "string" }
        }
      }
    },
    "knowledge_base_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bucket", "what_was_missing", "routed_to"],
        "properties": {
          "bucket": { "type": "string" },
          "what_was_missing": { "type": "string" },
          "routed_to": {
            "type": "string",
            "enum": [
              "knowledge-harvest (content addition to a sound Validated bucket)",
              "knowledge-discovery - reopen (Validated bucket didn't hold up)",
              "knowledge-discovery - first pass (never validated)"
            ]
          },
          "status": { "type": "string" }
        }
      }
    },
    "end_to_end_test": {
      "type": "object",
      "required": ["ticket_used", "result"],
      "properties": {
        "ticket_used": { "type": "string" },
        "joiner_role_in_test": { "type": "string" },
        "result": { "type": "string", "enum": ["Pass", "Pass with gap", "Fail"] }
      }
    },
    "person_readiness": { "type": "string", "enum": ["Ready", "Not yet"] },
    "confirmed_by": {
      "type": "string",
      "description": "Named onboarding buddy or delivery lead — not the joiner self-certifying."
    },
    "confirmation_date": { "type": "string", "format": "date" },
    "knowledge_base_defect_count": { "type": "integer" }
  }
}
