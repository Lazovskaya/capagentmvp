{
  "type": "object",
  "description": "Client-facing architecture index that assembles evidence from the delivery chain without replacing per-delta records.",
  "required": ["package_id", "status", "owner", "scope", "executive_summary", "architecture_views", "source_artifacts", "traceability", "risks", "assumptions", "dependencies", "approvals", "open_decisions"],
  "properties": {
    "package_id": { "type": "string" },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REOPENED"] },
    "owner": { "type": "string" },
    "reviewer": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "systems", "process_areas"],
      "properties": {
        "engagement": { "type": "string" },
        "release": { "type": "string" },
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "systems": { "type": "array", "items": { "type": "string" } },
        "process_areas": { "type": "array", "items": { "type": "string" } },
        "regions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executive_summary": { "type": "string" },
    "architecture_views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["view", "recommendation", "evidence_refs", "status", "owner"],
        "properties": {
          "view": { "type": "string" },
          "recommendation": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["COMPLETE", "TBC", "NOT_APPLICABLE"] },
          "owner": { "type": "string" },
          "due_date": { "type": "string", "format": "date" }
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "ref", "status"],
        "properties": {
          "artifact_type": { "type": "string" },
          "ref": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" },
          "relationship": { "type": "string" }
        }
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "fts_row_id", "design_id", "extensibility_id", "overall_status"],
        "properties": {
          "requirement_id": { "type": "string" },
          "fts_row_id": { "type": "string" },
          "design_id": { "type": "string" },
          "extensibility_id": { "type": "string" },
          "backlog_id": { "type": "string" },
          "build_config_id": { "type": "string" },
          "test_id": { "type": "string" },
          "defect_id": { "type": "string" },
          "approval_id": { "type": "string" },
          "overall_status": { "type": "string", "enum": ["MISSING", "DRAFT", "IN_REVIEW", "APPROVED", "IMPLEMENTED", "TESTED", "ACCEPTED", "REOPENED"] },
          "gaps": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "nfrs": { "type": "array", "items": { "type": "object" } },
    "risks": { "type": "array", "items": { "type": "object" } },
    "assumptions": { "type": "array", "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "open_decisions": { "type": "array", "items": { "type": "object" } },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "name", "decision", "date"],
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" },
          "decision": { "type": "string", "enum": ["APPROVED", "REJECTED", "PENDING", "NOT_APPLICABLE"] },
          "date": { "type": "string", "format": "date" },
          "comment": { "type": "string" }
        }
      }
    }
  }
}