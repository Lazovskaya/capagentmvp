# Signavio Process Manager credentials — script-pattern connector
# See connectors/signavio/connector.md for full setup instructions.
#
# Copy this file OUTSIDE the repo before filling in real values:
#   cp connectors/signavio/.env.example ~/.config/signavio/sessions/default.env
#
# Then pass it to the tools via --env-file:
#   python3 tools/enrich_sap_best_practices_signavio.py --env-file ~/.config/signavio/sessions/default.env
#   python3 tools/fetch_bpmn_signavio.py --env-file ~/.config/signavio/sessions/default.env
#
# Use a dedicated technical/integration user — NOT a personal account.
# Never commit a filled-in copy of this file.

# Signavio host — the shared SAP SaaS editor unless your org has a dedicated domain.
SIGNAVIO_HOST=https://editor.signavio.com

# Workspace/Tenant ID — Signavio Explorer → Administration → API tab → "Tenant ID".
SIGNAVIO_TENANT_ID=your-workspace-tenant-id

# Technical user email and password (integration/auto account, not personal).
SIGNAVIO_USER=your-technical-user@example.com
SIGNAVIO_PASSWORD=your-password
