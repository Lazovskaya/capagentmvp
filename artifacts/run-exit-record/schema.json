{
  "type": "object",
  "description": "Named approver, four-way disposition per open item, and knowledge-harvest cycle confirmation. Both the evidence and the mechanism for the run-exit gate, which Activate doesn't define.",
  "required": [
    "period_closing",
    "approver",
    "date",
    "deploy_run_handoff",
    "open_items",
    "harvest_confirmation"
  ],
  "properties": {
    "period_closing": {
      "type": "string",
      "description": "e.g. 'Hypercare, Sprint 1-14' or 'AMS contract year 1'."
    },
    "approver": {
      "type": "string",
      "description": "Named, empowered to accept carry-over/commercial decisions."
    },
    "date": { "type": "string", "format": "date" },
    "deploy_run_handoff": {
      "type": "object",
      "description": "Operational contract handed from Deploy into Run before hypercare starts.",
      "required": ["go_live_signoff_ref", "handoff_status", "hypercare_window", "service_owner", "rollback_owner", "entry_criteria", "operational_baseline"],
      "properties": {
        "go_live_signoff_ref": { "type": "string" },
        "production_conversion_ref": { "type": "string" },
        "cutover_rehearsal_ref": { "type": "string" },
        "handoff_status": { "type": "string", "enum": ["READY", "READY_WITH_EXCEPTIONS", "BLOCKED"] },
        "hypercare_window": { "type": "string" },
        "service_owner": { "type": "string" },
        "on_call_path": { "type": "string" },
        "rollback_owner": { "type": "string" },
        "entry_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "status"],
            "properties": {
              "criterion": { "type": "string" },
              "status": { "type": "string", "enum": ["PASS", "EXCEPTION", "BLOCKED", "NOT_APPLICABLE"] },
              "evidence_ref": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        },
        "operational_baseline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "target_or_baseline", "source", "window", "owner"],
            "properties": {
              "metric": { "type": "string" },
              "target_or_baseline": { "type": "string" },
              "source": { "type": "string" },
              "window": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        }
      }
    },
    "open_items": {
      "type": "array",
      "description": "Every open item from defect-triage's triage-verdict log for the period. No silent option outside the four dispositions.",
      "items": {
        "type": "object",
        "required": ["item_ref", "classification", "disposition"],
        "properties": {
          "item_ref": { "type": "string" },
          "classification": { "type": "string", "enum": ["Bug", "Spec flaw", "Untraceable"] },
          "disposition": {
            "type": "string",
            "enum": [
              "Resolved",
              "Carried over - scheduled",
              "Carried over - red flag",
              "Escalated - traceability gap"
            ]
          },
          "owner": { "type": "string" },
          "reason_or_evidence": { "type": "string" },
          "contingent_on_contract_renewal": { "type": "boolean" }
        }
      }
    },
    "harvest_confirmation": {
      "type": "object",
      "required": ["cycle_header", "cycle_status"],
      "properties": {
        "cycle_header": {
          "type": "string",
          "description": "Cited verbatim from the harvest-log, not duplicated. Should be named '<Period> Closing Harvest' when run specifically for this gate."
        },
        "cycle_status": { "type": "string", "enum": ["Ran", "Skipped"] },
        "deltas_accepted": { "type": "array", "items": { "type": "string" } },
        "recurring_rejection_escalations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Substance keys from the harvest-log's recurrence tracker flagged as worth escalating."
        },
        "escalation_owner": { "type": "string" }
      }
    }
  }
}
