{
  "type": "object",
  "description": "Reviewable source-to-target object and field mapping, built from a migration-objects-list inventory against a target data model. AI-suggested field mappings are runtime output, not approved decisions until a reviewer confirms them.",
  "required": ["source_inventory", "generated_at", "version", "mappings"],
  "properties": {
    "source_inventory": {
      "type": "object",
      "required": ["artifact", "version"],
      "properties": {
        "artifact": { "type": "string", "const": "migration-objects-list" },
        "version": { "type": "string" }
      }
    },
    "target_model_reference": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_type", "status", "fields"],
        "properties": {
          "object_type": { "type": "string" },
          "object_name_or_prefix": { "type": "string" },
          "target_object": { "type": "string" },
          "status": { "type": "string", "enum": ["MATCHED", "UNMAPPED", "REVIEW_REQUIRED"] },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_field", "confidence"],
              "properties": {
                "source_field": { "type": "string" },
                "target_field": { "type": "string" },
                "match_basis": { "type": "string" },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                "transformation_notes": { "type": "string" }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "field": { "type": "string" },
                "description": { "type": "string" },
                "review_owner": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
