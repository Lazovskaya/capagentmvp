{
  "type": "object",
  "description": "One non-technical delivery-strategy document (Cutover, Training, Testing, or Convention), decided from project scope and context rather than SAP standard content.",
  "required": ["strategy_type", "generated_at", "scope_basis", "decisions", "cross_strategy_dependencies", "status"],
  "properties": {
    "strategy_type": { "type": "string", "enum": ["Cutover", "Training", "Testing", "Convention"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope_basis": {
      "type": "object",
      "description": "The project-scope and context inputs this strategy's decisions were actually grounded in.",
      "properties": {
        "source_fit_gap": { "type": "string" },
        "source_object_mapping": { "type": "string" },
        "other_context": { "type": "string" }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "decision", "rationale"],
        "properties": {
          "topic": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "open_question": { "type": "string" }
        }
      }
    },
    "cross_strategy_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["depends_on_strategy_type", "description"],
        "properties": {
          "depends_on_strategy_type": { "type": "string", "enum": ["Cutover", "Training", "Testing", "Convention"] },
          "description": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REOPENED"] }
  }
}
