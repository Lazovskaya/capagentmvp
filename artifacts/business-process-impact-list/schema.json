{
  "type": "object",
  "description": "Catalog-derived, human-reviewable list of business-process impacts. It records potential impact only; client-specific applicability remains the responsibility of readiness-analysis.",
  "required": [
    "catalog_source",
    "generated_at",
    "target_release",
    "items"
  ],
  "properties": {
    "catalog_source": {
      "type": "object",
      "required": ["name", "downloaded_at", "files"],
      "properties": {
        "name": { "type": "string" },
        "downloaded_at": { "type": "string", "format": "date-time" },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_release": { "type": "string" },
    "source_release": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_guid",
          "item_id",
          "title",
          "application_area",
          "impact_classification",
          "process_mappings",
          "evidence_refs",
          "review_status"
        ],
        "properties": {
          "item_guid": { "type": "string" },
          "item_id": { "type": "string" },
          "title": { "type": "string" },
          "application_area": { "type": "string" },
          "impact_note": { "type": "string" },
          "target_release_categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "category_text", "valid_from_product_version", "valid_to_product_version"],
              "properties": {
                "category": { "type": "string" },
                "category_text": { "type": "string" },
                "valid_from_product_version": { "type": "string" },
                "valid_to_product_version": { "type": "string" }
              }
            }
          },
          "impact_classification": {
            "type": "string",
            "enum": ["mandatory", "conditional", "informational"]
          },
          "process_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["business_process", "mapping_basis", "confidence"],
              "properties": {
                "business_process": { "type": "string" },
                "candidate_transaction_codes": { "type": "array", "items": { "type": "string" } },
                "mapping_basis": { "type": "string" },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
              }
            }
          },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "review_status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REOPENED"] },
          "assumptions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}