{
  "type": "object",
  "description": "Pointers to the test-coverage-matrix (test-case-design) and e2e-test-scenarios (e2e-test-scenario-generation) artifacts produced by one test-generation run, plus coverage against supplied specs/tickets. Never re-embeds the referenced artifacts' own content.",
  "required": ["generated_at", "test_coverage_matrix_ref", "e2e_test_scenarios_ref", "spec_coverage_status", "spec_coverage"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "test_coverage_matrix_ref": {
      "type": "object",
      "required": ["artifact", "generated_at"],
      "properties": {
        "artifact": { "type": "string", "const": "test-coverage-matrix" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "e2e_test_scenarios_ref": {
      "type": "object",
      "required": ["artifact", "generated_at"],
      "properties": {
        "artifact": { "type": "string", "const": "e2e-test-scenarios" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "spec_coverage_status": { "type": "string", "enum": ["PERFORMED", "NOT_PERFORMED"] },
    "spec_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spec_ref", "status"],
        "properties": {
          "spec_ref": { "type": "string" },
          "status": { "type": "string", "enum": ["COVERED", "UNCOVERED"] },
          "traced_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
