{
  "type": "object",
  "description": "One cumulative Architecture Decision Record log for an SAP engagement, raised into by every phase, plus a History sheet of every status change. Rendered as a real .xlsx by skills/adr-log/scripts/update_adr_log.py, not hand-edited.",
  "required": ["entries", "history"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "raised_by", "date_raised", "date_last_updated"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["Proposed", "Decided", "Reopened", "Deprecated", "Superseded", "Rejected"] },
          "raised_by": { "type": "string", "description": "Which skill/agent/person raised this entry" },
          "date_raised": { "type": "string", "format": "date" },
          "date_last_updated": { "type": "string", "format": "date" },
          "context": { "type": "string" },
          "options_considered": { "type": "array", "items": { "type": "string" }, "description": "Unioned across updates, never overwritten" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "caveats": {
            "type": "string",
            "description": "A specific unresolved or qualified claim inside an otherwise Decided/Proposed entry (e.g. \"decided, but not yet cost-estimated\" or \"based on an ST03N-gap item, treat as assessment-required\") -- kept separate from `status` so a reader skimming the status column doesn't take a qualified call at full face value. Empty when there's nothing to flag."
          },
          "owner": { "type": "string" },
          "sad_section": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Unioned across updates, never overwritten" },
          "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{3}$" } },
          "superseded_by": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{3}$" } }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from_status", "to_status", "date"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
          "from_status": { "type": "string" },
          "to_status": { "type": "string", "enum": ["Proposed", "Decided", "Reopened", "Deprecated", "Superseded", "Rejected"] },
          "date": { "type": "string", "format": "date" },
          "raised_by": { "type": "string" }
        }
      }
    }
  }
}
