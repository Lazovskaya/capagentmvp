{
  "type": "object",
  "description": "Complexity-ordered Fit-to-Standard workshop schedule plus per-session agendas, built from conversion-scoping's business-process-scope output. Rendered as a real .xlsx schedule and .md agendas by skills/workshop-scheduling/scripts/build_workshop_agendas.py.",
  "required": ["sessions"],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "business_area", "complexity_score", "objective", "process_walkthrough"],
        "properties": {
          "order": { "type": "integer" },
          "business_area": { "type": "string" },
          "changed_count": { "type": "integer" },
          "to_assess_count": { "type": "integer" },
          "technical_blocker_count": { "type": "integer" },
          "complexity_score": { "type": "number" },
          "suggested_duration_minutes": { "type": "integer" },
          "suggested_attendee_roles": { "type": "array", "items": { "type": "string" } },
          "objective": {
            "type": "string",
            "description": "Must read as confirmation/delta-resolution, not generic workshop boilerplate."
          },
          "open_adrs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "status"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          },
          "process_walkthrough": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["process", "status"],
              "properties": {
                "process": { "type": "string" },
                "status": { "type": "string" },
                "driving_item": { "type": "string" },
                "applications": { "type": "array", "items": { "type": "string" } },
                "confirmed_decision": { "type": "string", "description": "Left blank for the live session." }
              }
            }
          },
          "technical_blockers_fyi": {
            "type": "array",
            "description": "Separate FYI-only table, excluded from the discussion-time complexity score.",
            "items": {
              "type": "object",
              "required": ["process", "driving_item"],
              "properties": {
                "process": { "type": "string" },
                "driving_item": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
