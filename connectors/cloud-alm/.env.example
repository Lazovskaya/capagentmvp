# SAP Cloud ALM credentials — script-pattern connector
# See connectors/cloud-alm/connector.md "Script integration" section for context.
#
# Copy this file OUTSIDE the repo before filling in real values:
#   cp connectors/cloud-alm/.env.example ~/.config/cloud-alm/sessions/default.env
#
# Source values from your Cloud ALM BTP service key:
#   BTP cockpit → Instances and Subscriptions → your Cloud ALM instance
#   → Service Keys → open the service key JSON
#
# Never commit a filled-in copy of this file.

# OAuth2 token endpoint: service key "uaa.url" + "/oauth/token"
CLOUD_ALM_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token

# Client ID and secret from the service key ("clientid" / "clientsecret")
CLOUD_ALM_CLIENT_ID=sb-your-client-id!t12345
CLOUD_ALM_CLIENT_SECRET=your-client-secret

# Cloud ALM API base URL: service key "url" field
CLOUD_ALM_API_URL=https://your-tenant.alm.cloud.sap
