{
  "type": "object",
  "description": "Coverage-checked workshop preparation plan derived from supplied process scope and optional simplification impacts. Feeds fit-to-standard; it is not a decision log or sign-off record.",
  "required": ["generated_at", "topics", "coverage"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "delivery_mode": {
      "type": "string",
      "enum": ["onsite", "remote", "hybrid"],
      "description": "Determines whether remote-facilitation checklist applies"
    },
    "schedule": {
      "type": "array",
      "description": "Workshop track schedule. Chart of Accounts first, Org Structure second, Finance last.",
      "items": {
        "type": "object",
        "required": ["track", "duration_days"],
        "properties": {
          "track": { "type": "string" },
          "scope_item_ids": { "type": "array", "items": { "type": "string" } },
          "duration_days": { "type": "number" },
          "parallel_with": { "type": "array", "items": { "type": "string" } },
          "sequencing_constraint": { "type": "string" }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "process_ids", "topic", "required_decisions"],
        "properties": {
          "module": { "type": "string" },
          "process_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "topic": { "type": "string" },
          "scope_item_ids": { "type": "array", "items": { "type": "string" } },
          "simplification_item_ids": { "type": "array", "items": { "type": "string" } },
          "required_decisions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "scope_item_plan": {
      "type": "array",
      "description": "Per-workshop scope item and participant plan. Max 8 BPEs per session.",
      "items": {
        "type": "object",
        "required": ["workshop", "scope_items"],
        "properties": {
          "workshop": { "type": "string" },
          "scope_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "in_scope"],
              "properties": {
                "id": { "type": "string" },
                "in_scope": { "type": "boolean" }
              }
            }
          },
          "participants": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["role"],
              "properties": {
                "role": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["process_id", "process_name", "status"],
        "properties": {
          "process_id": { "type": "string" },
          "process_name": { "type": "string" },
          "status": { "type": "string", "enum": ["COVERED", "REVIEW_REQUIRED"] },
          "reason": { "type": "string" }
        }
      }
    },
    "remote_checklist_complete": {
      "type": "boolean",
      "description": "Set true only when delivery_mode is remote or hybrid and all remote checklist items are confirmed"
    }
  }
}
