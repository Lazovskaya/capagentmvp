# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor/IDE
.vscode/
.idea/

# Logs and temp files
*.log
tmp.html
/_tmp

# Per-engagement outputs — every skill's own "Output" section says these are gitignored;
# .gitignore itself never actually had the entry until a real skill run needed it (2026-08-07).
workspace/

# Personal Claude Code config: local-only files and machine-specific settings are ignored;
# shared project config (skills, agents for contributors) lives in .claude/ and IS committed.
.claude/.local/
.claude/settings.local.json

# Filled-in pilot infrastructure/client context (P4, EPMCSAPAI-294) — real hosts/client numbers
# and credentialRef env-var wiring for an actual engagement never get committed, only
# platform/pilot-context/context.example.json (redacted) does.
platform/pilot-context/*.context.json
platform/pilot-context/pilot-*.json

# SAP Best Practices scope-item cache: committed as a snapshot (2026-08-24) because the enriched
# L1/L2/BPMN data represents our own processing work, not just a raw SAP export. Regenerate with
# ingest → enrich → bpmn → populate_l1 when SAP updates FAL or Signavio content.
# knowledge/domain-packs/sap-best-practices/scope-items/  <-- no longer ignored

# Real credential files -- only the *.example template is ever committed. This factory's
# convention (see connectors/jira, connectors/abap-mcp) is that filled-in secrets live outside the
# project entirely (~/.config/<tool>/sessions/<destination>.env); this rule is a safety net in
# case someone fills in a template in place before moving it out.
**/.env
!**/.env.example
