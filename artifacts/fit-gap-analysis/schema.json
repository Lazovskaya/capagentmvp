{
  "type": "object",
  "description": "Reviewable fit-gap analysis derived from Fit-to-Standard decision-log rows. It documents business disposition but does not select an extensibility tier.",
  "required": ["source_decision_log", "generated_at", "review_status", "items"],
  "properties": {
    "source_decision_log": {
      "type": "object",
      "required": ["log_id", "session_status"],
      "properties": {
        "log_id": { "type": "string" },
        "session_status": { "type": "string", "enum": ["LIVE", "DRAFT"] },
        "process": { "type": "string" },
        "process_app_mapping_ref": { "type": "string" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "review_status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REOPENED"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row_id", "process_step", "classification", "disposition", "status"],
        "properties": {
          "row_id": { "type": "string" },
          "process_step": { "type": "string" },
          "classification": { "type": "string", "enum": ["FIT", "GAP", "WORKAROUND", "TBC"] },
          "sap_standard_behavior": { "type": "string" },
          "requirement": { "type": "string" },
          "app_ids": { "type": "array", "items": { "type": "string" } },
          "disposition": { "type": "string", "enum": ["standard", "solution-design-required", "open-question", "not-applicable"] },
          "rationale": { "type": "string" },
          "owner": { "type": "string" },
          "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REOPENED"] }
        }
      }
    }
  }
}