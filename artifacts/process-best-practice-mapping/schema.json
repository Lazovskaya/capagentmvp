{
  "type": "object",
  "description": "Reviewable 1:many mapping from supplied business processes to SAP Best Practices scope items in knowledge/domain-packs/sap-best-practices/. The domain pack is reusable factory knowledge, not a per-run input, so this schema cites the pack's snapshot date rather than a source-file hash.",
  "required": ["domain_pack_snapshot", "generated_at", "mappings"],
  "properties": {
    "domain_pack_snapshot": {
      "type": "object",
      "required": ["path", "date", "scope_item_count"],
      "properties": {
        "path": { "type": "string", "const": "knowledge/domain-packs/sap-best-practices/" },
        "date": { "type": "string", "format": "date" },
        "scope_item_count": { "type": "integer", "minimum": 1 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["process_id", "process_name", "status", "candidates"],
        "properties": {
          "process_id": { "type": "string" },
          "process_name": { "type": "string" },
          "status": { "type": "string", "enum": ["MATCHED", "UNMAPPED", "REVIEW_REQUIRED"] },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["scope_item_id", "title", "match_basis", "confidence"],
              "properties": {
                "scope_item_id": { "type": "string" },
                "title": { "type": "string" },
                "l1_value_stream": { "type": ["string", "null"] },
                "l1_gap_note": { "type": "string" },
                "match_basis": { "type": "string" },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
              }
            }
          },
          "review_notes": { "type": "string" }
        }
      }
    }
  }
}
